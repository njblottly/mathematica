Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"counts", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"PrimePi", "[", 
       RowBox[{"100", " ", "k"}], "]"}], "-", 
      RowBox[{"PrimePi", "[", 
       RowBox[{"100", " ", 
        RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "10"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"labels", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"k", "==", "1"}], ",", "0", ",", 
          RowBox[{
           RowBox[{"100", " ", 
            RowBox[{"(", 
             RowBox[{"k", "-", "1"}], ")"}]}], "+", "1"}]}], "]"}], "]"}], 
       "<>", "\"\<\[Dash]\>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"100", " ", "k"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "10"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"BarChart", "[", 
  RowBox[{"counts", ",", 
   RowBox[{"ChartLabels", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{"labels", ",", "Axis", ",", 
      RowBox[{
       RowBox[{"Rotate", "[", 
        RowBox[{"#", ",", 
         RowBox[{"Pi", "/", "4"}]}], "]"}], "&"}]}], "]"}]}], ",", 
   RowBox[{"LabelingFunction", "->", "Above"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Range\>\"", ",", "\"\<Primes\>\""}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", "->", 
    "\"\<Number of primes in each block of 100 up to 1000\>\""}], ",", 
   RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], "Input",
