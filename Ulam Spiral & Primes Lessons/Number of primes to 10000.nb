Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"estimate", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"100", " ", "k"}], "-", "50"}], ",", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"LogIntegral", "[", 
           RowBox[{"100", " ", "k"}], "]"}], "-", 
          RowBox[{"LogIntegral", "[", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"100", " ", 
              RowBox[{"(", 
               RowBox[{"k", "-", "1"}], ")"}]}], ",", "2"}], "]"}], "]"}]}], 
         "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "100"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Histogram", "[", 
    RowBox[{"primes", ",", 
