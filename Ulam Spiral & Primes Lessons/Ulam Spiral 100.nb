Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pos", "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "=", "0"}], ",", 
        RowBox[{"y", "=", "0"}], ",", 
        RowBox[{"dx", "=", "1"}], ",", 
        RowBox[{"dy", "=", "0"}], ",", 
        RowBox[{"steps", "=", "1"}], ",", 
        RowBox[{"count", "=", "0"}], ",", 
        RowBox[{"turns", "=", "0"}]}], "}"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"p", "=", 
            RowBox[{"{", 
             RowBox[{"x", ",", 
              RowBox[{"-", "y"}]}], "}"}]}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}], "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x", "+", "dx"}], ",", 
              RowBox[{"y", "+", "dy"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"count", "==", "steps"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"dx", ",", "dy"}], "}"}], "=", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "dy"}], ",", "dx"}], "}"}]}], ";", 
              RowBox[{"count", "=", "0"}], ";", 
              RowBox[{"turns", "++"}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"turns", "==", "2"}], ",", 
                RowBox[{
                 RowBox[{"steps", "++"}], ";", 
                 RowBox[{"turns", "=", "0"}]}]}], "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", "p"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "100"}], "}"}]}], "]"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"primeColour", "=", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"0.45", ",", "0.35", ",", "0.85"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"draw", "[", "m_", "]"}], ":=", 
    RowBox[{"Graphics", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"GrayLevel", "[", "0.75", "]"}], ",", 
          RowBox[{"Thickness", "[", "0.004", "]"}], ",", 
          RowBox[{"Line", "[", 
           RowBox[{"pos", "[", 
            RowBox[{"[", 
             RowBox[{";;", "m"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Which", "[", 
             RowBox[{
              RowBox[{"PrimeQ", "[", "k", "]"}], ",", "primeColour", ",", 
              RowBox[{"k", "==", "1"}], ",", 
              RowBox[{"GrayLevel", "[", "0.6", "]"}], ",", "True", ",", 
              RowBox[{"GrayLevel", "[", "0.94", "]"}]}], "]"}], ",", 
            RowBox[{"EdgeForm", "[", 
             RowBox[{"GrayLevel", "[", "0.7", "]"}], "]"}], ",", 
            RowBox[{"Rectangle", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"pos", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "-", "0.42"}], ",", 
              RowBox[{
               RowBox[{"pos", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "+", "0.42"}]}], "]"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"PrimeQ", "[", "k", "]"}], "||", 
               RowBox[{"k", "==", "1"}]}], ",", "White", ",", 
              RowBox[{"GrayLevel", "[", "0.35", "]"}]}], "]"}], ",", 
            RowBox[{"Text", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"k", ",", "13", ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"PrimeQ", "[", "k", "]"}], ",", "Bold", ",", 
                  "Plain"}], "]"}]}], "]"}], ",", 
              RowBox[{"pos", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "m"}], "}"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "4.6"}], ",", "5.6"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "5.6"}], ",", "4.6"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"ImageSize", "->", "520"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"draw", "[", "m", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", "100", ",", "\"\<Numbers shown\>\""}], "}"}], ",", 
