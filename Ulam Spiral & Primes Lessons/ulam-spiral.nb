Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "901"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spiral", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0.", ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"n", "+", "1"}], ")"}], "/", "2"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"n", "+", "1"}], ")"}], "/", "2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dx", ",", "dy"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"steps", "=", "1"}], ";", 
   RowBox[{"count", "=", "0"}], ";", 
   RowBox[{"turns", "=", "0"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"PrimeQ", "[", "k", "]"}], ",", 
        RowBox[{
         RowBox[{"spiral", "[", 
          RowBox[{"[", 
           RowBox[{"y", ",", "x"}], "]"}], "]"}], "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"N", "[", "k", "]"}], "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "+", "dx"}], ",", 
         RowBox[{"y", "+", "dy"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"count", "==", "steps"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"dx", ",", "dy"}], "}"}], "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "dy"}], ",", "dx"}], "}"}]}], ";", 
         RowBox[{"count", "=", "0"}], ";", 
         RowBox[{"turns", "++"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"turns", "==", "2"}], ",", 
           RowBox[{
            RowBox[{"steps", "++"}], ";", 
            RowBox[{"turns", "=", "0"}]}]}], "]"}]}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", 
       RowBox[{"n", "^", "2"}]}], "}"}]}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"palette", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.15", ",", "0.55", ",", "1"}], "]"}], ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.75", ",", "0.3", ",", "1"}], "]"}], ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"1", ",", "0.35", ",", "0.5"}], "]"}], ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"1", ",", "0.8", ",", "0.3"}], "]"}]}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plot", "=", 
    RowBox[{"ArrayPlot", "[", 
     RowBox[{"spiral", ",", 
      RowBox[{"ColorFunction", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"#", "==", "0"}], ",", "Black", ",", 
           RowBox[{"Blend", "[", 
            RowBox[{"palette", ",", "#"}], "]"}]}], "]"}], "&"}], ")"}]}], 
      ",", 
      RowBox[{"ColorFunctionScaling", "->", "True"}], ",", 
      RowBox[{"Frame", "->", "False"}], ",", 
      RowBox[{"PixelConstrained", "->", "1"}], ",", 
      RowBox[{"PlotRangePadding", "->", "None"}], ",", 
      RowBox[{"Background", "->", "Black"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"img", "=", 
   RowBox[{"Image", "[", "plot", "]"}]}], ";"}], "\n", 
 RowBox[{"ImageAdd", "[", 
  RowBox[{"img", ",", 
   RowBox[{"ImageMultiply", "[", 
    RowBox[{
     RowBox[{"GaussianFilter", "[", 
      RowBox[{"img", ",", "3"}], "]"}], ",", "1.6"}], "]"}]}], 
  "]"}]}], "Input",
