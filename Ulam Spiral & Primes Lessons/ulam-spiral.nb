Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "901"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spiral", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"n", "+", "1"}], ")"}], "/", "2"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"n", "+", "1"}], ")"}], "/", "2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dx", ",", "dy"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"steps", "=", "1"}], ";", 
  RowBox[{"count", "=", "0"}], ";", 
  RowBox[{"turns", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"PrimeQ", "[", "k", "]"}], ",", 
       RowBox[{
        RowBox[{"spiral", "[", 
         RowBox[{"[", 
          RowBox[{"y", ",", "x"}], "]"}], "]"}], "=", "1"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "+", "dx"}], ",", 
        RowBox[{"y", "+", "dy"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"count", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"count", "==", "steps"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"dx", ",", "dy"}], "}"}], "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "dy"}], ",", "dx"}], "}"}]}], ";", 
        RowBox[{"count", "=", "0"}], ";", 
        RowBox[{"turns", "++"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"turns", "==", "2"}], ",", 
          RowBox[{
           RowBox[{"steps", "++"}], ";", 
           RowBox[{"turns", "=", "0"}]}]}], "]"}]}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", 
      RowBox[{"n", "^", "2"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"ArrayPlot", "[", 
  RowBox[{"spiral", ",", 
   RowBox[{"ColorRules", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"0", "->", "White"}], ",", 
      RowBox[{"1", "->", "Blue"}]}], "}"}]}], ",", 
   RowBox[{"Frame", "->", "False"}], ",", 
   RowBox[{"ImageSize", "->", "600"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.991275406745434*^9, 3.991275406750906*^9}, {
  3.9912754710832787`*^9, 3.9912754916943607`*^9}, {3.991275540332789*^9, 
