                  RowBox[{"{", 
                   RowBox[{
                   "350", ",", "500", ",", "700", ",", "900", ",", "1200"}], 
                   "}"}]}], "]"}], ",", "SpanFromLeft", ",", "SpanFromLeft"}],
                "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<Max iterations\>\"", ",", 
                RowBox[{"SetterBar", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "maxIter", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                   "100", ",", "250", ",", "350", ",", "500", ",", "750", ",",
