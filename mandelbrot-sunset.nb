                    ",", "\"\<Rainbow\>\""}], "}"}]}], "]"}], ",", 
                "SpanFromLeft", ",", "SpanFromLeft"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<Click zoom factor\>\"", ",", 
                RowBox[{"Slider", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "zoomFactor", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"0.15", ",", "0.8"}], "}"}]}], "]"}], ",", 
