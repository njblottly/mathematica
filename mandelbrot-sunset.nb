 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mandelbrotKernel", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"cx", ",", "_Real"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"cy", ",", "_Real"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"width", ",", "_Real"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "_Integer"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"maxIter", ",", "_Integer"}], "}"}]}], "}"}], ",", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"data", "=", 
           RowBox[{"Table", "[", 
            RowBox[{"0.", ",", 
             RowBox[{"{", "n", "}"}], ",", 
             RowBox[{"{", "n", "}"}]}], "]"}]}], ",", "x0", ",", "y0", ",", 
          "x", ",", "y", ",", "x2", ",", "y2", ",", "i", ",", "j", ",", "k", 
          ",", "smooth", ",", "xmin", ",", "xmax", ",", "ymin", ",", "ymax"}],
          "}"}], ",", 
        RowBox[{
         RowBox[{"xmin", "=", 
          RowBox[{"cx", "-", 
           RowBox[{"width", "/", "2."}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"xmax", "=", 
          RowBox[{"cx", "+", 
           RowBox[{"width", "/", "2."}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"ymin", "=", 
          RowBox[{"cy", "-", 
           RowBox[{"width", "/", "2."}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"ymax", "=", 
          RowBox[{"cy", "+", 
           RowBox[{"width", "/", "2."}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<=", "n"}], ",", 
           RowBox[{"j", "++"}], ",", 
           RowBox[{
            RowBox[{"y0", "=", 
             RowBox[{"ymax", "-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"j", "-", "1."}], ")"}], "*", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"ymax", "-", "ymin"}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{"n", "-", "1."}], ")"}]}]}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"i", "=", "1"}], ",", 
              RowBox[{"i", "<=", "n"}], ",", 
              RowBox[{"i", "++"}], ",", 
              RowBox[{
               RowBox[{"x0", "=", 
                RowBox[{"xmin", "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"i", "-", "1."}], ")"}], "*", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"xmax", "-", "xmin"}], ")"}], "/", 
                   RowBox[{"(", 
                    RowBox[{"n", "-", "1."}], ")"}]}]}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"x", "=", "0."}], ";", "\[IndentingNewLine]", 
               RowBox[{"y", "=", "0."}], ";", "\[IndentingNewLine]", 
               RowBox[{"x2", "=", "0."}], ";", "\[IndentingNewLine]", 
               RowBox[{"y2", "=", "0."}], ";", "\[IndentingNewLine]", 
               RowBox[{"k", "=", "0"}], ";", "\[IndentingNewLine]", 
               RowBox[{"While", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"k", "<", "maxIter"}], "&&", 
                  RowBox[{
                   RowBox[{"x2", "+", "y2"}], "<=", "4."}]}], ",", 
                 RowBox[{
                  RowBox[{"y", "=", 
                   RowBox[{
                    RowBox[{"2.", "*", "x", "*", "y"}], "+", "y0"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"x", "=", 
                   RowBox[{"x2", "-", "y2", "+", "x0"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"x2", "=", 
                   RowBox[{"x", "*", "x"}]}], ";", "\[IndentingNewLine]", 
                  RowBox[{"y2", "=", 
                   RowBox[{"y", "*", "y"}]}], ";", "\[IndentingNewLine]", 
                  RowBox[{"k", "++"}], ";"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"k", "<", "maxIter"}], ",", 
                 RowBox[{
                  RowBox[{"smooth", "=", 
                   RowBox[{"k", "+", "1.", "-", 
                    RowBox[{
                    RowBox[{"Log", "[", 
                    RowBox[{"Log", "[", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{"x2", "+", "y2"}], "]"}], "]"}], "]"}], "/", 
                    RowBox[{"Log", "[", "2.", "]"}]}]}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"data", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", 
                   RowBox[{"smooth", "/", "maxIter"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "i"}], "]"}], "]"}], "<", "0."}], ",", 
                    RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", "0."}]}], 
                   "]"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "i"}], "]"}], "]"}], ">", "1."}], ",", 
                    RowBox[{
                    RowBox[{"data", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", "1."}]}], 
                   "]"}]}], ",", 
                 RowBox[{
                  RowBox[{"data", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", "i"}], "]"}], "]"}], "=", "0."}]}], 
                "]"}], ";"}]}], "]"}], ";"}]}], "]"}], ";", 
         "\[IndentingNewLine]", "data"}]}], "]"}], ",", 
      RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mandelbrotPlot", "[", 
     RowBox[{
     "center_", ",", "width_", ",", "resolution_", ",", "maxIter_", ",", 
      "scheme_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data", ",", "xmin", ",", "xmax", ",", "ymin", ",", "ymax"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"xmin", ",", "xmax"}], "}"}], "=", 
        RowBox[{
         RowBox[{"center", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "width"}], "/", "2"}], ",", 
           RowBox[{"width", "/", "2"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ymin", ",", "ymax"}], "}"}], "=", 
        RowBox[{
         RowBox[{"center", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "+", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "width"}], "/", "2"}], ",", 
           RowBox[{"width", "/", "2"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"data", "=", 
        RowBox[{"mandelbrotKernel", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"center", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{"N", "[", 
           RowBox[{"center", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
          RowBox[{"N", "[", "width", "]"}], ",", "resolution", ",", 
          "maxIter"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ArrayPlot", "[", 
        RowBox[{"data", ",", 
         RowBox[{"DataRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"xmin", ",", "xmax"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ymin", ",", "ymax"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], ",", 
         RowBox[{"ColorFunction", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"#", "<=", 
               RowBox[{"10", "^", 
                RowBox[{"-", "12"}]}]}], ",", "Black", ",", 
              RowBox[{
               RowBox[{"ColorData", "[", "scheme", "]"}], "[", "#", "]"}]}], 
             "]"}], "&"}], ")"}]}], ",", 
         RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
         RowBox[{"AspectRatio", "->", "1"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"Axes", "->", "False"}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"GridLinesStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"GrayLevel", "[", 
            RowBox[{"0.7", ",", "0.25"}], "]"}], "]"}]}], ",", 
         RowBox[{"ImageSize", "->", "650"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Re(c)\>\"", ",", "12"}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Im(c)\>\"", ",", "12"}], "]"}]}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<Centre = \>\"", ",", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"center", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"14", ",", "10"}], "}"}]}], "]"}], ",", 
               "\"\< + \>\"", ",", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"center", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"14", ",", "10"}], "}"}]}], "]"}], ",", 
               "\"\< i     Width = \>\"", ",", 
               RowBox[{"ScientificForm", "[", 
                RowBox[{"width", ",", "4"}], "]"}], ",", 
               "\"\<     Iterations = \>\"", ",", "maxIter"}], "}"}], "]"}], 
            ",", "12"}], "]"}]}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mandelbrotExplorer", ":=", 
    RowBox[{"DynamicModule", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"center", "=", 
