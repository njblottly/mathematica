                   RowBox[{"center", "=", 
                    RowBox[{"N", "[", "mousePoint", "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"width", "=", 
                    RowBox[{"N", "[", 
                    RowBox[{"width", "*", "zoomFactor"}], "]"}]}], ";"}]}], 
                 "]"}], ";"}], ")"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"Dynamic", "[", 
           RowBox[{"Grid", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
