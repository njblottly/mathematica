      ",", 
      RowBox[{"Column", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<Interactive Mandelbrot Explorer\>\"", ",", "18", ",", 
            "Bold"}], "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<Click on the image to recenter and zoom. Use Back to return \
to the previous view. Increase iterations as you zoom deeper.\>\"", ",", 
            "12"}], "]"}], ",", 
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Button", "[", 
                 RowBox[{"\"\<Reset\>\"", ",", 
                  RowBox[{
                   RowBox[{"center", "=", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "0.75"}], ",", "0."}], "}"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"width", "=", "3."}], ";", "\[IndentingNewLine]", 
                   RowBox[{"history", "=", 
                    RowBox[{"{", "}"}]}]}], ",", 
                  RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
                RowBox[{"Button", "[", 
                 RowBox[{"\"\<Back\>\"", ",", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "history", "]"}], ">", "0"}], ",", 
                    
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"center", ",", "width"}], "}"}], "=", 
                    RowBox[{"Last", "[", "history", "]"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"history", "=", 
                    RowBox[{"Most", "[", "history", "]"}]}], ";"}]}], "]"}], 
                  ",", 
                  RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
                RowBox[{"Button", "[", 
                 RowBox[{"\"\<Zoom in at centre\>\"", ",", 
                  RowBox[{
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"history", ",", 
                    RowBox[{"{", 
                    RowBox[{"center", ",", "width"}], "}"}]}], "]"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"width", "=", 
                    RowBox[{"width", "*", "zoomFactor"}]}]}], ",", 
                  RowBox[{"Method", "->", "\"\<Queued\>\""}]}], "]"}], ",", 
                RowBox[{"Button", "[", 
                 RowBox[{"\"\<Zoom out at centre\>\"", ",", 
