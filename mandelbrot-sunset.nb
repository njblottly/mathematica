                  "]"}], ",", "SpanFromLeft", ",", "SpanFromLeft"}], "}"}], 
              ",", 
              RowBox[{"{", 
               RowBox[{"\"\<Colour scheme\>\"", ",", 
                RowBox[{"PopupMenu", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "scheme", "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                   "\"\<SunsetColors\>\"", ",", "\"\<AvocadoColors\>\"", ",", 
