Cell[BoxData[
 DynamicModuleBox[{$CellContext`center$$ = {-0.75, 0.}, $CellContext`width$$ =
   3., $CellContext`resolution$$ = 700, $CellContext`maxIter$$ = 
  350, $CellContext`scheme$$ = "SunsetColors", $CellContext`zoomFactor$$ = 
  0.8, $CellContext`history$$ = {}, $CellContext`mousePoint$$ = \
{-1.1679472356686798`, -0.24271818659957556`}, $CellContext`exportFile$$}, 
  TagBox[GridBox[{
     {
      StyleBox["\<\"Interactive Mandelbrot Explorer\"\>",
       StripOnInput->False,
       FontSize->18,
       FontWeight->Bold]},
     {
      StyleBox["\<\"Click on the image to recenter and zoom. Use Back to \
return to the previous view. Increase iterations as you zoom deeper.\"\>",
       StripOnInput->False,
       FontSize->12]},
     {
      TagBox[GridBox[{
         {
          ButtonBox["\<\"Reset\"\>",
           Appearance->Automatic,
           
           ButtonFunction:>($CellContext`center$$ = {-0.75, 
              0.}; $CellContext`width$$ = 3.; $CellContext`history$$ = {}),
           Evaluator->Automatic,
           Method->"Queued"], 
          ButtonBox["\<\"Back\"\>",
           Appearance->Automatic,
           
           ButtonFunction:>If[
            Length[$CellContext`history$$] > 
             0, {$CellContext`center$$, $CellContext`width$$} = 
              Last[$CellContext`history$$]; $CellContext`history$$ = 
              Most[$CellContext`history$$]; Null],
           Evaluator->Automatic,
           Method->"Queued"], 
          ButtonBox["\<\"Zoom in at centre\"\>",
           Appearance->Automatic,
           
           ButtonFunction:>(
            AppendTo[$CellContext`history$$, {$CellContext`center$$, \
$CellContext`width$$}]; $CellContext`width$$ = $CellContext`width$$ \
$CellContext`zoomFactor$$),
           Evaluator->Automatic,
           Method->"Queued"], 
          ButtonBox["\<\"Zoom out at centre\"\>",
           Appearance->Automatic,
           
           ButtonFunction:>(
            AppendTo[$CellContext`history$$, {$CellContext`center$$, \
$CellContext`width$$}]; $CellContext`width$$ = \
$CellContext`width$$/$CellContext`zoomFactor$$),
           Evaluator->Automatic,
           Method->"Queued"]},
         {"\<\"Resolution\"\>", 
