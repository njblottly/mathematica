                 RowBox[{"NumberForm", "[", 
                  RowBox[{"zoomFactor", ",", 
                   RowBox[{"{", 
                    RowBox[{"3", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
                "SpanFromLeft"}], "}"}]}], "}"}], ",", 
            RowBox[{"Alignment", "->", "Left"}], ",", 
            RowBox[{"Spacings", "->", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}], ",", 
          RowBox[{"EventHandler", "[", 
           RowBox[{
            RowBox[{"Dynamic", "[", 
             RowBox[{
              RowBox[{"mandelbrotPlot", "[", 
               RowBox[{
               "center", ",", "width", ",", "resolution", ",", "maxIter", ",",
                 "scheme"}], "]"}], ",", 
              RowBox[{"TrackedSymbols", ":>", 
               RowBox[{"{", 
                RowBox[{
                "center", ",", "width", ",", "resolution", ",", "maxIter", 
                 ",", "scheme"}], "}"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"\"\<MouseClicked\>\"", ":>", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"mousePoint", "=", 
                 RowBox[{"MousePosition", "[", "\"\<Graphics\>\"", "]"}]}], 
                ";", "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
